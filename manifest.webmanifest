{
  "id": "pos-txbd",
  "name": "POS TXbd — Point of Sale",
  "short_name": "POS TXbd",
  "description": "Multi-tenant point-of-sale for retail — fast checkout, live inventory, reporting, subscriptions.",
  "start_url": "portal.html",
  "scope": ".",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#5145d8",
  "categories": ["business", "productivity", "shopping"],
  "icons": [
    { "src": "assets/logos/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/logos/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/logos/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/logos/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Cashier terminal", "url": "cashier.html", "description": "Start selling" },
    { "name": "Admin dashboard", "url": "admin.html", "description": "Manage the shop" }
  ]
}
