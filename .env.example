# ---------------------------------------------------------------------------
# POS TXbd - environment configuration EXAMPLE
# Copy to `.env` for your deployment tooling, or edit js/config.js directly for
# a pure static deploy. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Data mode: "mock" uses the in-browser localStorage database (default).
# "rest" makes the frontend talk to a real backend via APP_API_BASE_URL.
APP_DATA_MODE=mock

# Base URL of the REST API when APP_DATA_MODE=rest (no trailing slash).
APP_API_BASE_URL=https://api.example.com/v1

# Public app metadata
APP_NAME=POS TXbd
APP_DEFAULT_CURRENCY=BDT
APP_DEFAULT_LOCALE=en-BD

# Simulated network latency for the mock API in milliseconds (dev realism).
APP_MOCK_LATENCY_MS=120

# Feature flags
APP_ENABLE_PWA=true
APP_ENABLE_CAMERA_SCANNER=true

# ---------------------------------------------------------------------------
# The following belong ONLY on the backend. They are listed here so integrators
# know they exist - do NOT put real values in any frontend-served file.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://user:pass@host:5432/pos_txbd
# JWT_SECRET=change-me
# PAYMENT_GATEWAY_SECRET_KEY=change-me
